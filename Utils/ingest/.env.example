# Required — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Slack (optional — browser SSO, no API token needed)
# Paste any channel URL from your workspace:
#   Open Slack in browser -> right-click a channel -> Copy link
SLACK_WORKSPACE_URL=
# JSON map of label -> channel URL for daily auto-sync
# Example: {"slackbot": "https://app.slack.com/client/TXXXXXXXX/DXXXXXXXX"}
SLACK_CHANNELS=

# Confluence (optional)
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=you@yourcompany.com
CONFLUENCE_API_TOKEN=
